# Generated by api-onboarding-kit from spec '{{ spec.name }}'. Do not hand-edit.
# Pairs with {{ spec.name }}.openapi.yaml and {{ spec.name }}.usage-plan.json
# rendered by the same spec.
{% set rl = (policies | selectattr("type", "equalto", "rate-limit") | first) %}

resource "aws_api_gateway_rest_api" "{{ spec.name | replace('-', '_') }}" {
  name        = "{{ spec.name }}"
  description = "Onboarded consumer {{ spec.name }} ({{ spec.contact }})"
  body        = file("${path.module}/{{ spec.name }}.openapi.yaml")

  endpoint_configuration {
    types = ["REGIONAL"]
  }
}

resource "aws_api_gateway_deployment" "{{ spec.name | replace('-', '_') }}" {
  rest_api_id = aws_api_gateway_rest_api.{{ spec.name | replace('-', '_') }}.id

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_api_gateway_stage" "{{ spec.name | replace('-', '_') }}" {
  deployment_id = aws_api_gateway_deployment.{{ spec.name | replace('-', '_') }}.id
  rest_api_id   = aws_api_gateway_rest_api.{{ spec.name | replace('-', '_') }}.id
  stage_name    = "v1"
}

resource "aws_api_gateway_usage_plan" "{{ spec.name | replace('-', '_') }}" {
  name = "{{ spec.name }}"

  api_stages {
    api_id = aws_api_gateway_rest_api.{{ spec.name | replace('-', '_') }}.id
    stage  = aws_api_gateway_stage.{{ spec.name | replace('-', '_') }}.stage_name
  }

  throttle_settings {
    burst_limit = {{ spec.burst_rps }}
    rate_limit  = {{ ((rl.calls / rl.periodSeconds) | round(1)) if rl else 16.7 }}
  }

  quota_settings {
    limit  = {{ (rl.calls * 1440) if rl else 1440000 }}
    period = "DAY"
  }
}
