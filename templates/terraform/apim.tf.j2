# Generated by api-onboarding-kit from spec '{{ spec.name }}'. Do not hand-edit.
# Pairs with {{ spec.name }}.policy.xml rendered by the same spec.

variable "resource_group_name" { type = string }
variable "apim_name" { type = string }

resource "azurerm_api_management_api" "{{ spec.name | replace('-', '_') }}" {
  name                = "{{ spec.name }}"
  resource_group_name = var.resource_group_name
  api_management_name = var.apim_name
  revision            = "1"
  display_name        = "{{ spec.name }}"
  path                = "{{ spec.name }}"
  protocols           = ["https"]
}

resource "azurerm_api_management_api_policy" "{{ spec.name | replace('-', '_') }}_policy" {
  api_name            = azurerm_api_management_api.{{ spec.name | replace('-', '_') }}.name
  api_management_name = var.apim_name
  resource_group_name = var.resource_group_name
  xml_content         = file("${path.module}/{{ spec.name }}.policy.xml")
}

resource "azurerm_api_management_product" "{{ spec.name | replace('-', '_') }}_product" {
  product_id            = "{{ spec.name }}"
  api_management_name   = var.apim_name
  resource_group_name   = var.resource_group_name
  display_name          = "{{ spec.name }}"
  subscription_required = true
  approval_required     = {{ "true" if "prod" in spec.environments else "false" }}
}

resource "azurerm_api_management_product_api" "{{ spec.name | replace('-', '_') }}_link" {
  api_name            = azurerm_api_management_api.{{ spec.name | replace('-', '_') }}.name
  product_id          = azurerm_api_management_product.{{ spec.name | replace('-', '_') }}_product.product_id
  api_management_name = var.apim_name
  resource_group_name = var.resource_group_name
}
