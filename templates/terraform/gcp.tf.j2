# Generated by api-onboarding-kit from spec '{{ spec.name }}'. Do not hand-edit.
# Pairs with {{ spec.name }}.openapi.yaml rendered by the same spec.

variable "project_id" { type = string }
variable "region" { type = string }

resource "google_api_gateway_api" "{{ spec.name | replace('-', '_') }}" {
  provider = google-beta
  api_id   = "{{ spec.name }}"
  project  = var.project_id
}

resource "google_api_gateway_api_config" "{{ spec.name | replace('-', '_') }}" {
  provider      = google-beta
  api           = google_api_gateway_api.{{ spec.name | replace('-', '_') }}.api_id
  api_config_id = "{{ spec.name }}-v1"
  project       = var.project_id

  openapi_documents {
    document {
      path     = "{{ spec.name }}.openapi.yaml"
      contents = filebase64("${path.module}/{{ spec.name }}.openapi.yaml")
    }
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "google_api_gateway_gateway" "{{ spec.name | replace('-', '_') }}" {
  provider   = google-beta
  api_config = google_api_gateway_api_config.{{ spec.name | replace('-', '_') }}.id
  gateway_id = "{{ spec.name }}"
  project    = var.project_id
  region     = var.region
}
