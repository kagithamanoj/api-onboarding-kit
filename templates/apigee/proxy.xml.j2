<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Generated by api-onboarding-kit from spec '{{ spec.name }}'.
     Policy library version: {{ policy_library_version }}.
     Do not hand-edit: regenerate from the consumer spec. -->
<APIProxy name="{{ spec.name }}">
    <Description>Onboarded consumer {{ spec.name }} ({{ spec.contact }})</Description>
    <Policies>
{% for policy in policies %}
        <!-- {{ policy.ref }}: {{ policy.description }} -->
{% endfor %}
    </Policies>
    <ProxyEndpoints>
        <ProxyEndpoint name="default">
            <HTTPProxyConnection>
                <BasePath>/{{ spec.name }}/v1</BasePath>
            </HTTPProxyConnection>
            <RouteRule name="default">
                <TargetEndpoint>default</TargetEndpoint>
            </RouteRule>
        </ProxyEndpoint>
    </ProxyEndpoints>
    <TargetEndpoints>
        <TargetEndpoint name="default">
            <HTTPTargetConnection>
                <URL>https://backend.internal/{{ spec.name }}</URL>
            </HTTPTargetConnection>
        </TargetEndpoint>
    </TargetEndpoints>
</APIProxy>
