<policies>
    <!-- Generated by api-onboarding-kit from spec '{{ spec.name }}'.
         Policy library version: {{ policy_library_version }}.
         Do not hand-edit: regenerate from the consumer spec. -->
    <inbound>
        <base />
{% for policy in policies %}
        <!-- policy: {{ policy.ref }} ({{ policy.description }}) -->
{% if policy.type == "rate-limit" %}
        <rate-limit-by-key calls="{{ policy.calls }}" renewal-period="{{ policy.periodSeconds }}"
            counter-key="@(context.Subscription.Id)" />
{% elif policy.type == "cors" %}
        <cors allow-credentials="{{ policy.allowCredentials | lower }}">
            <allowed-origins>
{% for origin in policy.allowedOrigins %}
                <origin>{{ origin }}</origin>
{% endfor %}
            </allowed-origins>
            <allowed-methods>
{% for method in policy.allowedMethods %}
                <method>{{ method }}</method>
{% endfor %}
            </allowed-methods>
        </cors>
{% elif policy.type == "auth" %}
        <!-- auth enforced upstream: {{ spec.auth_method }} -->
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401">
            <openid-config url="{{ policy.openIdConfigUrl }}" />
        </validate-jwt>
{% elif policy.type == "ip-allowlist" %}
        <ip-filter action="allow">
{% for cidr in policy.cidrs %}
            <address-range from="{{ cidr.split('/')[0] }}" to="{{ cidr.split('/')[0] }}" />
{% endfor %}
        </ip-filter>
{% endif %}
{% endfor %}
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
