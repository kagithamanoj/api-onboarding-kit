# Generated by api-onboarding-kit from spec '{{ spec.name }}'.
# Policy library version: {{ policy_library_version }}.
# Google Cloud API Gateway service config. Do not hand-edit:
# regenerate from the consumer spec.
openapi: 3.0.0
info:
  title: {{ spec.name }}
  version: 1.0.0
  description: Onboarded consumer {{ spec.name }} ({{ spec.contact }})
servers:
  - url: https://{{ spec.name }}-gateway.example.com
x-google-allow: all
x-google-backend:
  address: {{ backend }}
  protocol: h2
paths:
  /v1/*:
    get:
      summary: Proxied consumer traffic
      operationId: proxyGet
      responses:
        '200':
          description: OK
    post:
      summary: Proxied consumer traffic
      operationId: proxyPost
      responses:
        '200':
          description: OK
{% set rl = (policies | selectattr("type", "equalto", "rate-limit") | first) %}
x-google-metrics:
  - name: {{ spec.name }}-requests
    displayName: Requests for {{ spec.name }}
    valueType: INT64
    metricKind: DELTA
x-google-quota:
  limits:
    - name: {{ spec.name }}-limit
      metric: {{ spec.name }}-requests
      unit: "1/min"
      values:
        STANDARD: {{ rl.calls if rl else 1000 }}
# Auth: {{ spec.auth_method }} (enforced via ESPv2 / Identity-Aware Proxy per environment)
# Selected policies:
{% for policy in policies %}
# - {{ policy.ref }}: {{ policy.description }}
{% endfor %}
