{
  "comment": "Generated by api-onboarding-kit from spec '{{ spec.name }}'. Policy library version: {{ policy_library_version }}. Do not hand-edit: regenerate from the consumer spec.",
  "name": "{{ spec.name }}",
  "description": "Usage plan for {{ spec.name }} ({{ spec.contact }})",
{% set rl = (policies | selectattr("type", "equalto", "rate-limit") | first) %}
  "throttle": {
    "rateLimit": {{ ((rl.calls / rl.periodSeconds) | round(1)) if rl else 16.7 }},
    "burstLimit": {{ spec.burst_rps }}
  },
  "quota": {
    "limit": {{ (rl.calls * 1440) if rl else 1440000 }},
    "period": "DAY"
  }
}
